{
  "buildCommand": "npm install --legacy-peer-deps && npx react-scripts build",
  "outputDirectory": "build",
  "devCommand": "npm start",
  "installCommand": "npm install --legacy-peer-deps",
  "framework": "create-react-app",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "env": {
    "REACT_APP_BASE_URL": "https://lending-library-backend-new.onrender.com"
  }
}